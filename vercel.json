{
    "rewrites": [
        { "source": "/demo", "destination": "/api/demo/index.php" },
        { "source": "/demo/", "destination": "/api/demo/index.php" },
        { "source": "/demo/:path*", "destination": "/api/demo/vercel-static.php" },
        { "source": "/(.*)", "destination": "/api/index.php" }
    ],
    "routes": [
        { "handle": "filesystem" },
        { "src": "/demo/?", "dest": "/api/demo/index.php" },
        { "src": "/demo/(.+)", "dest": "/api/demo/vercel-static.php" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0"
        },
        "api/demo/index.php": {
            "runtime": "vercel-php@0.9.0"
        },
        "api/demo/vercel-static.php": {
            "runtime": "vercel-php@0.9.0"
        }
    }
}
